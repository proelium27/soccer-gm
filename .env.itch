# Loaded by `vite build --mode itch` (npm run build:itch).
# Switches the app to hash-based routing so it works inside itch.io's iframe.
VITE_BUILD_TARGET=itch

# Analytics, same values as .env.production — duplicated rather than shared,
# because Vite loads only `.env` and `.env.<mode>`, and .env.production is
# itself a mode file (mode "production"). It is not loaded for `--mode itch`,
# so a key set only there would leave this build shipping posthog-js with no
# project token: initialized, inert, and reporting nothing. `.env` would cover
# both, but it is gitignored, which is the out-of-band storage this whole
# arrangement exists to avoid. Unlike the CrazyGames build (which aliases
# posthog-js away
# entirely and takes no key), this bundle really does contain the SDK, so it may
# as well be pointed somewhere. itch traffic arrives under its own `$host`, so
# it is filterable and separable from worldsoccersim.org.
#
# Delete these two lines if you would rather the itch build stay dark; nothing
# else depends on them.
VITE_POSTHOG_KEY=phc_nqhYqPRCqWKbvbmWV4Nqs4NzmVP2xA8fUgtAMdGnF9FZ
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional. URL of the community roster file offered on the Import Custom
# League screen — see the longer note in .env.production. Unset renders no
# link. Fine to enable here: the itch build is a normal page in an iframe and
# an outbound download breaks nothing.
# VITE_ROSTER_DOWNLOAD_URL=https://example.com/real-players-teams.json
