node_modules/
dist/
*.log

# Distribution bundles. Built on demand (npm run package:crazygames), never
# committed — they are just the app compiled.
dist-crazygames/
soccer-gm-crazygames.zip
soccer-gm-itch.zip
.DS_Store
.playwright-mcp/
.env

# Real-player roster imports (see docs/eafc-import.md). The game ships
# fictional clubs on purpose; source datasets and anything generated from them
# stay local and are never committed or bundled into a build.
*.csv
eafc-roster.json
*-roster.json
roster-identities.json

# Exported saves sent in by players, for debugging. Other people's game data —
# large, and not ours to publish.
leaguesaves/
soccer-gm-league-*.json

# Two-machine test runner (scripts/testCluster.sh). The config names your other
# Mac and holds its measured throughput, so it's yours and not the repo's.
.test-cluster.json
.vitest-reports/
.test-cluster-run/
